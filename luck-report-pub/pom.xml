<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.luck.product</groupId>
        <artifactId>luck-report-server</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>luck-report-pub</artifactId>
    <name>Luck Report Pub</name>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- luck-report-web 的 spring-boot-starter-web 为 provided, 需要在此显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- javax.servlet-api: luck-report-web 中 Filter/Interceptor 方法签名需要, provided 传递不到此处 -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Thymeleaf: luck-report-web 的 ViewController 需要, 适配器模块中为 provided 需显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Spring Boot2 Servlet 适配器, SPI 自动发现 -->
        <dependency>
            <groupId>com.luck.product</groupId>
            <artifactId>luck-report-spring-boot2-starter</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 向量检索、持久化依赖，按需引入 -->
<!--        <dependency>-->
<!--            <groupId>com.luck.product</groupId>-->
<!--            <artifactId>luck-report-postgresql-vector</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

<!--        <dependency>-->
<!--            <groupId>com.luck.product</groupId>-->
<!--            <artifactId>luck-report-milvus-vector</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

<!--        <dependency>-->
<!--            <groupId>com.luck.product</groupId>-->
<!--            <artifactId>luck-report-chroma-vector</artifactId>-->
<!--            <version>${revision}</version>-->
<!--        </dependency>-->

        <dependency>
            <groupId>com.luck.product</groupId>
            <artifactId>luck-report-redis</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- JSqlParser: luck-report-core 中为 provided, 需显式引入 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>

        <!-- 数据库驱动 -->
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
        </dependency>
        <dependency>
            <groupId>com.oracle</groupId>
            <artifactId>ojdbc14</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dameng</groupId>
            <artifactId>DmJdbcDriver18</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.luck.report.pub.LuckReportApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*.yml</include>
                    <include>**/*.yaml</include>
                    <include>**/*.properties</include>
                    <include>**/*.xml</include>
                </includes>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.yml</exclude>
                    <exclude>**/*.yaml</exclude>
                    <exclude>**/*.properties</exclude>
                    <exclude>**/*.xml</exclude>
                </excludes>
                <filtering>false</filtering>
            </resource>
        </resources>
    </build>

</project>
